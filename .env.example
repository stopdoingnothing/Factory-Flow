# Copy this file to .env and fill in values before running docker compose
#
# Persistent data layout (on the host, never committed to git):
#   ./data/postgres/   — live PostgreSQL files (bind-mounted into the db container)
#   ./data/backups/    — hourly pg_dump .sql.gz files, 7-day retention

# Postgres password — used by both the db service and the DATABASE_URL for the app
POSTGRES_PASSWORD=changeme

# Express session secret — use a long random string in production
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-this-to-a-long-random-string

# Postmark API key for email notifications (leave empty to disable emails)
POSTMARK_API_KEY=
